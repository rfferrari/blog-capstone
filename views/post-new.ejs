<%- include("partials/header.ejs") %>

    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <header
                class="flex items-center justify-between whitespace-nowrap border-b border-slate-200 dark:border-slate-800 px-6 md:px-10 py-3 bg-background-light dark:bg-background-dark sticky top-0 z-10">
                <div class="flex items-center gap-4">
                    <span class="material-symbols-outlined text-primary text-3xl">draw</span>
                    <h2 class="text-lg font-bold leading-tight tracking-[-0.015em] text-gray-900 dark:text-white">My
                        Blog
                    </h2>
                </div>
                <div class="flex flex-1 justify-end items-center gap-4 md:gap-8">
                    <a class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary"
                        href="/">Back to Posts</a>
                    <button onclick="addPost()"
                        class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em]">
                        <span class="truncate">Publish</span>
                    </button>
                </div>
            </header>
            <main class="flex-1 px-4 sm:px-6 lg:px-8 py-8">
                <div class="max-w-7xl mx-auto">
                    <div class="flex flex-wrap gap-2 pb-6">
                        <span class="text-slate-800 dark:text-white text-sm font-medium leading-normal">New Post</span>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Main Content Area -->
                        <div class="lg:col-span-2 space-y-6">
                            <div
                                class="bg-white dark:bg-slate-900/70 p-6 rounded-xl border border-slate-200 dark:border-slate-800">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300"
                                    for="excerpt">Title</label>
                                <label class="flex flex-col w-full">
                                    <input
                                        class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-800 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 focus:border-primary/50 dark:focus:border-primary/50 h-14 placeholder:text-slate-400 dark:placeholder:text-slate-500 p-4 text-2xl font-bold leading-normal"
                                        placeholder="Your Post Title" type="text" name="title"
                                        value="" />
                                </label>
                            </div>
                            <div
                                class="flex flex-col rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 overflow-hidden">
                                <div class="flex flex-1 flex-col">
                                    <textarea id="content" contenteditable="true"
                                        class="form-input flex w-full min-w-0 flex-1 resize-y overflow-hidden text-slate-700 dark:text-slate-300 focus:outline-0 focus:ring-0 border-none bg-transparent min-h-96 placeholder:text-slate-400 dark:placeholder:text-slate-500 p-6 text-base font-normal leading-relaxed"
                                        placeholder="Start writing your story..." type="text"
                                        name="content"></textarea>
                                </div>
                                <div
                                    class="border-t border-slate-200 dark:border-slate-800 px-6 py-2 text-right text-xs text-slate-500 dark:text-slate-400">
                                    <span>Word Count: 0</span>
                                </div>
                            </div>
                        </div>
                        <!-- Sidebar -->
                        <div class="lg:col-span-1 space-y-6">
                            <div
                                class="bg-white dark:bg-slate-900/70 rounded-xl border border-slate-200 dark:border-slate-800 p-6 space-y-4 h-full">
                                <h3
                                    class="text-slate-800 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">
                                    Settings</h3>
                                <div class="space-y-2">
                                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300"
                                        for="excerpt">Thumbnail</label>
                                        <div class="aspect-video w-full bg-cover bg-center col-span-1" data-alt="Thumbnail image"
                                            style="background-image: url();">
                                        </div>
                                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300"
                                                    for="excerpt">Link thumbnail image:</label>
                                                <input
                                                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-800 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 focus:border-primary/50 dark:focus:border-primary/50 h-14 placeholder:text-slate-400 dark:placeholder:text-slate-500 p-4 text-2xl font-bold leading-normal"
                                                    placeholder="Thumbnail link" type="text" name="thumbnail"
                                                    value="" />

                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300"
                                        for="excerpt">Summary</label>
                                    <textarea
                                        class="form-input flex w-full h-full min-w-0 flex-1 resize-y overflow-hidden rounded-lg text-slate-700 dark:text-slate-300 focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 focus:border-primary/50 dark:focus:border-primary/50 min-h-24 placeholder:text-slate-400 dark:placeholder:text-slate-500 p-3 text-sm font-normal leading-normal"
                                        id="summary" placeholder="Write a short summary..." type="text"
                                        name="summary"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="/js/post.js"></script>
    <%- include("partials/footer.ejs") %>